# nanopb options for trace.proto
# Sets maximum sizes for variable-length fields

# TaskEntry: max 16 char task name
domes.trace.TaskEntry.name  max_size:16

# TraceSessionInfo: bounded catalogs that fit the shared 1024-byte frame payload
domes.trace.TraceSessionInfo.tasks  max_count:16
domes.trace.ObjectEntry.name  max_size:16
domes.trace.TraceSessionInfo.objects  max_count:8

# TraceDataChunk: max 256 bytes = 16 events * 16 bytes
domes.trace.TraceDataChunk.events  max_size:256

# StreamBatch: 16 events, bounded below the shared 1024-byte frame payload
domes.trace.StreamBatch.events  max_size:256
