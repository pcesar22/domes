    "physical.production": {
      "implementation": "NFF production firmware path on ESP32-S3 target hardware",
      "inputs": "Real board peripherals, clocks, storage, radios, and runtime configuration",
      "outputs": "Real target state and physical or transport effects",
      "timing": "ESP32-S3 hardware time and production FreeRTOS scheduling",
      "calibration": "Physical verification evidence is authoritative",
      "limitations": "No simulation claim; component behavior depends on the attached NFF revision"
    },
    "qemu.production": {
      "implementation": "Unmodified production DOMES source on ESP-IDF FreeRTOS",
      "inputs": "Profile-declared adapters plus target FreeRTOS and ESP-IDF APIs",
      "outputs": "Production service, runtime, NVS, and trace state",
      "timing": "Target FreeRTOS tick and esp_timer over QEMU virtual target time",
      "calibration": "Not calibrated to physical duration or scheduling probability",
      "limitations": "Production source fidelity does not imply physical peripheral or radio fidelity"
    },
    "qemu.service_ready_workload": {
      "implementation": "Versioned service_ready_v1 workload executed by the QEMU composition root",
      "inputs": "Manifest identity and random inputs plus deterministic LED, IMU, haptic, audio, and touch adapters",
      "outputs": "One authenticated readiness marker covering final mode, feature, and game state; exactly one hit on the scripted pad with zero misses; duplicate-free task entry and core placement; adapter progress; NVS; and trace evidence",
      "timing": "350 ms target-tick dwell with a 100 ms touch release and a 1000 ms game timeout",
      "calibration": "Exact inputs and outputs are repeatability-checked; duration and scheduling probabilities are not calibrated to hardware",
      "limitations": "Synthetic startup workload only; it does not model radio transport, peripheral physics, wall-clock performance, or field traffic"
    },
    "qemu.disabled": {
      "implementation": "Excluded from the QEMU composition root and runtime source closure",
      "inputs": "None",
      "outputs": "None",
      "timing": "None",
      "calibration": "Not applicable",
      "limitations": "No behavior, availability, or predictive claim"
    },
    "qemu.cpu": {
      "implementation": "Pinned Espressif QEMU ESP32-S3 Xtensa TCG cores",
      "inputs": "Target instructions, interrupts, and memory operations",
      "outputs": "Dual-core architectural execution state",
      "timing": "Deterministic single-thread TCG with fixed icount shift",
      "calibration": "Not cycle-calibrated to silicon",
      "limitations": "No cache, bus-contention, power, RF, or wall-clock performance prediction"
    },
    "qemu.interrupt": {
      "implementation": "Pinned QEMU ESP32-S3 interrupt matrix model",
      "inputs": "Modeled target-device interrupt assertions",
      "outputs": "Target interrupt delivery into the Xtensa port",
      "timing": "QEMU virtual instruction time",
      "calibration": "Feasibility-proven only; not latency-calibrated",
      "limitations": "Only interrupts implemented by the pinned engine are represented"
    },
    "qemu.flash": {
      "implementation": "Snapshot-backed 8 MB raw QEMU MTD image",
      "inputs": "ESP-IDF flash reads, writes, erases, and generated partition image",
      "outputs": "Modeled flash bytes visible to production NVS and boot code",
      "timing": "QEMU device-model timing, not physical erase or program timing",
      "calibration": "NVS round-trip checked; physical latency and wear not calibrated",
      "limitations": "No retention, wear, brownout, or electrical fault model"
    },
    "qemu.console": {
      "implementation": "QEMU UART0 mapped to the captured serial stream",
      "inputs": "ESP-IDF boot and application log writes",
      "outputs": "Bounded runner log and readiness marker",
      "timing": "QEMU virtual target execution with host pipe buffering",
      "calibration": "Content checked; throughput and latency not calibrated",
      "limitations": "Not equivalent to the NFF USB-Serial/JTAG console or USB-CDC transport"
    },
    "adapter.identity": {
      "implementation": "Fixed six-byte locally administered identity adapter",
      "inputs": "Manifest identity 020000000001",
      "outputs": "One deterministic PlatformIdentity read",
      "timing": "Immediate target call",
      "calibration": "Exact-value assertion",
      "limitations": "Does not model eFuse, STA MAC provisioning, uniqueness, or read failure"
    },
    "adapter.random": {
      "implementation": "Finite recorded uint32 input adapter",
      "inputs": "Manifest-ordered deterministic value sequence",
