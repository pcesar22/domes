diff --git a/hw/misc/domes_link.c b/hw/misc/domes_link.c
new file mode 100644
index 0000000000..abeab164c0
--- /dev/null
+++ b/hw/misc/domes_link.c
@@ -0,0 +1,627 @@
+#include "qemu/osdep.h"
+#include "hw/misc/domes_link.h"
+#include "hw/irq.h"
+#include "hw/qdev-properties.h"
+#include "qemu/log.h"
+#include "qemu/module.h"
+#define MAGIC 0x444c4e4b
+#define VERSION 1
+#define CAPABILITY 0x000
+#define ABI_VERSION 0x004
+#define MAX_PAYLOAD 0x008
+#define TX_DEST_LOW 0x010
+#define TX_DEST_HIGH 0x014
+#define TX_LENGTH 0x018
+#define TX_CORRELATION 0x01c
+#define TX_SUBMIT 0x020
+#define TX_STATUS 0x024
+#define RX_SOURCE_LOW 0x030
+#define RX_SOURCE_HIGH 0x034
+#define RX_RSSI 0x038
+#define RX_LENGTH 0x03c
+#define RX_CORRELATION 0x040
+#define RX_CONSUME 0x044
+#define RX_DEQUEUE 0x048
+#define IRQ_STATUS 0x050
+#define IRQ_MASK 0x054
+#define IRQ_ACK 0x058
+#define STICKY_STATUS 0x05c
+#define TX_PAYLOAD 0x100
+#define RX_PAYLOAD 0x200
+#define IRQ_TX BIT(0)
+#define IRQ_RX BIT(1)
+#define ST_OVERFLOW BIT(0)
+#define ST_INVALID BIT(1)
+#define ST_EXHAUSTED BIT(2)
+#define ST_MODEL_FAILURE BIT(3)
+#define ST_SEQUENCE BIT(4)
+#define ST_TRUNCATED BIT(5)
+#define ST_OVERWRITE BIT(6)
+#define ST_UNKNOWN_VERSION BIT(7)
+enum { TX_IDLE, TX_PENDING, TX_SUCCESS, TX_FAILURE };
+enum { SCENARIO_LOOPBACK, SCENARIO_FUNCTIONAL_PEER_V1 };
+enum { DUT_ROLE_MASTER = 1, DUT_ROLE_SLAVE = 2 };
+enum { MSG_BEACON = 0x01, MSG_PING = 0x02, MSG_PONG = 0x03,
+       MSG_JOIN_GAME = 0x10, MSG_ARM_TOUCH = 0x11, MSG_SET_COLOR = 0x12,
+       MSG_STOP_ALL = 0x13, MSG_SIMULATE_TOUCH = 0x14,
+       MSG_TOUCH_EVENT = 0x20, MSG_TIMEOUT_EVENT = 0x21 };
+static const uint8_t actor_mac[6] = { 0x02, 0, 0, 0, 0, 0x02 };
+enum {
+    FAULT_PASS,
+    FAULT_LOSS,
+    FAULT_DUPLICATION,
+    FAULT_REORDERING,
+    FAULT_JITTER,
+    FAULT_CORRUPTION,
+    FAULT_TRUNCATION,
+    FAULT_SUBMIT_FAILURE,
+    FAULT_COMPLETION_FAILURE,
+    FAULT_MISSING_COMPLETION,
+    FAULT_CALLBACK_BURST,
+    FAULT_COMPLETION_ORDER,
+    FAULT_SATURATION,
+    FAULT_BACKPRESSURE_RECOVERY,
+    FAULT_PEER_JOIN,
+    FAULT_PEER_DISAPPEARANCE,
+    FAULT_PEER_RESTART,
+    FAULT_STALE_TRAFFIC,
+    FAULT_IDENTITY_MISMATCH,
+    FAULT_CHANNEL_OUTCOME,
+    FAULT_INTERFERENCE_OUTCOME,
+    FAULT_LATENCY_TX_QUEUE,
+    FAULT_LATENCY_CHANNEL,
+    FAULT_LATENCY_AIRTIME,
+    FAULT_LATENCY_COMPLETION,
+    FAULT_LATENCY_PEER,
+    FAULT_LATENCY_RX_CALLBACK,
+    FAULT_COUNT,
+};
+enum { STAGE_TX_QUEUE, STAGE_CHANNEL, STAGE_AIRTIME, STAGE_COMPLETION, STAGE_PEER, STAGE_RX_CALLBACK };
+static const char *stage_name[] = { "tx_queue_delay", "channel_access", "airtime", "completion_delay", "peer_processing", "rx_callback_delay" };
+static void record_stage(uint32_t stage, int64_t enter_ns, int64_t exit_ns)
+{
+    qemu_log_mask(LOG_GUEST_ERROR, "DOMES_PIPELINE_BOUNDARY schema=1 stage=%s enter_ns=%" PRIi64
+                  " exit_ns=%" PRIi64 "\n", stage_name[stage], enter_ns, exit_ns);
+}
+static const char *fault_stage(uint32_t fault_id)
+{
+    switch (fault_id) {
+    case FAULT_CORRUPTION:
+    case FAULT_TRUNCATION:
+    case FAULT_IDENTITY_MISMATCH:
+        return "before_production_validation";
+    case FAULT_SUBMIT_FAILURE:
+        return "radio_submit";
+    case FAULT_COMPLETION_FAILURE:
+    case FAULT_MISSING_COMPLETION:
+    case FAULT_COMPLETION_ORDER:
+    case FAULT_LATENCY_COMPLETION:
+        return "completion_delay";
+    case FAULT_DUPLICATION:
+    case FAULT_REORDERING:
+    case FAULT_INTERFERENCE_OUTCOME:
+    case FAULT_LATENCY_AIRTIME:
+        return "airtime";
+    case FAULT_JITTER:
+    case FAULT_PEER_JOIN:
+    case FAULT_PEER_DISAPPEARANCE:
+    case FAULT_PEER_RESTART:
+    case FAULT_STALE_TRAFFIC:
+    case FAULT_LATENCY_PEER:
+        return "peer_processing";
+    case FAULT_CALLBACK_BURST:
+    case FAULT_LATENCY_RX_CALLBACK:
+        return "rx_callback_delay";
+    case FAULT_LATENCY_TX_QUEUE:
+        return "tx_queue_delay";
+    default:
+        return "channel_access";
+    }
+}
+static void record_fault(DomesLinkState *s, const char *stage, const char *outcome)
+{
+    qemu_log_mask(LOG_GUEST_ERROR,
+                  "DOMES_FAULT_RECORD schema=1 fault=%u sequence=%u virtual_ns=%" PRIi64
+                  " stage=%s outcome=%s queued=%u\n",
+                  s->fault_id, s->fault_sequence++,
+                  qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL), stage, outcome, s->event_count);
+}
+static void observe_state(DomesLinkState *s)
+{
+    int64_t now = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (now - s->last_observation_ns >= 100000000) {
+        qemu_log_mask(LOG_GUEST_ERROR,
+                      "DOMES_FAULT_STATE schema=1 virtual_ns=%" PRIi64 " queued=%u\n",
+                      now, s->event_count);
+        s->last_observation_ns = now;
+    }
+}
+static void record_peer(DomesLinkState *s, const char *state, uint32_t traffic_epoch, bool accepted)
+{
+    qemu_log_mask(LOG_GUEST_ERROR, "DOMES_PEER_STATE schema=1 state=%s present=%u epoch=%u traffic_epoch=%u accepted=%u\n",
+                  state, s->peer_present, s->peer_epoch, traffic_epoch, accepted);
+}
+static bool event_before(const DomesLinkEvent *a, const DomesLinkEvent *b)
+{
+    if (a->deadline_ns != b->deadline_ns) return a->deadline_ns < b->deadline_ns;
+    if (a->event_class_priority != b->event_class_priority) {
+        return a->event_class_priority < b->event_class_priority;
+    }
+    if (a->source_id != b->source_id) return a->source_id < b->source_id;
+    if (a->destination_id != b->destination_id) return a->destination_id < b->destination_id;
+    return a->sequence < b->sequence;
+}
+static bool enqueue_event(DomesLinkState *s, DomesLinkEvent event)
+{
+    uint32_t index;
+    if (s->event_count == DOMES_LINK_EVENT_CAPACITY) {
+        s->sticky |= ST_OVERFLOW;
+        return false;
+    }
+    event.sequence = s->next_sequence++;
+    for (index = s->event_count; index > 0 && event_before(&event, &s->events[index - 1]); index--) {
+        s->events[index] = s->events[index - 1];
+    }
+    s->events[index] = event;
+    s->event_count++;
+    return true;
+}
+static uint32_t wire_size(uint8_t type)
+{
+    switch (type) {
+    case MSG_BEACON: case MSG_PING: case MSG_PONG: case MSG_JOIN_GAME: case MSG_STOP_ALL:
+        return 11;
+    case MSG_ARM_TOUCH: case MSG_TOUCH_EVENT: return 20;
+    case MSG_SET_COLOR: return 14;
+    case MSG_SIMULATE_TOUCH: return 16;
+    case MSG_TIMEOUT_EVENT: return 15;
+    default: return 0;
+    }
+}
+static bool actor_transition(DomesLinkState *s, DomesLinkEvent *event)
+{
+    uint8_t type = s->tx_payload[0];
+    uint32_t expected = wire_size(type);
+    uint8_t response = 0;
+    if (!expected || expected != s->tx_length || (s->dut_role != DUT_ROLE_MASTER &&
+                                                  s->dut_role != DUT_ROLE_SLAVE)) {
+        return false;
+    }
+    if (s->fault_id == FAULT_PEER_JOIN) s->peer_present = true;
+    if (s->fault_id == FAULT_PEER_DISAPPEARANCE) s->peer_present = false;
+    if (s->fault_id == FAULT_PEER_RESTART) s->peer_epoch++;
+    if (s->fault_id == FAULT_STALE_TRAFFIC) s->peer_epoch = 2;
+    if (type == MSG_PING) response = MSG_PONG;
+    else if (type == MSG_BEACON) response =
+        s->dut_role == DUT_ROLE_SLAVE ? MSG_JOIN_GAME : MSG_BEACON;
+    else if (s->dut_role == DUT_ROLE_MASTER &&
+             (type == MSG_ARM_TOUCH || type == MSG_SIMULATE_TOUCH)) response = MSG_TOUCH_EVENT;
+    else if (type == MSG_JOIN_GAME || type == MSG_SET_COLOR || type == MSG_STOP_ALL) return true;
+    else return false;
+    if (s->fault_id == FAULT_LATENCY_PEER) s->stage_delay_ns[STAGE_PEER] = 10000;
+    event->deadline_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) +
+                         s->peer_delay_ns + s->stage_delay_ns[STAGE_PEER];
+    event->event_class_priority = 1;
+    event->source_id = 2;
+    event->destination_id = 1;
+    event->correlation = s->tx_correlation;
+    event->source_low = 0x00000002;
+    event->source_high = 0x00000200;
+    event->length = wire_size(response);
+    event->payload[0] = response;
+    memcpy(&event->payload[1], actor_mac, sizeof(actor_mac));
+    stl_le_p(&event->payload[7], s->scenario_seed);
+    if (response == MSG_TOUCH_EVENT) {
+        memcpy(&event->payload[11], &s->tx_payload[11], 4);
+        stl_le_p(&event->payload[15], 500);
+        event->payload[19] = type == MSG_SIMULATE_TOUCH ? s->tx_payload[15] : 0;
+    }
+    return true;
+}
+static void update_irq(DomesLinkState *s)
+{
+    qemu_set_irq(s->irq, (s->irq_status & s->irq_mask) != 0);
+}
+static bool word_access(hwaddr addr, unsigned size)
+{
+    return size == 4 && (addr & 3) == 0;
+}
+static bool tx_locked(DomesLinkState *s)
+{
+    return s->tx_status != TX_IDLE || (s->irq_status & IRQ_TX) != 0;
+}
+static void reject_tx_mutation(DomesLinkState *s)
+{
+    s->sticky |= ST_EXHAUSTED | ST_OVERWRITE;
+}
+static uint64_t link_read(void *opaque, hwaddr addr, unsigned size)
+{
+    DomesLinkState *s = opaque;
+    if (!word_access(addr, size)) {
+        s->sticky |= ST_INVALID;
+        return 0;
+    }
+    if (addr >= TX_PAYLOAD && addr < TX_PAYLOAD + sizeof(s->tx_payload)) {
+        return ldl_le_p(&s->tx_payload[addr - TX_PAYLOAD]);
+    }
+    if (addr >= RX_PAYLOAD && addr < RX_PAYLOAD + sizeof(s->rx_payload)) {
+        return ldl_le_p(&s->rx_payload[addr - RX_PAYLOAD]);
+    }
+    switch (addr) {
+    case CAPABILITY: return MAGIC;
+    case ABI_VERSION: return VERSION;
+    case MAX_PAYLOAD: return DOMES_LINK_MAX_PAYLOAD;
+    case TX_DEST_LOW: return s->tx_destination_low;
+    case TX_DEST_HIGH: return s->tx_destination_high;
+    case TX_LENGTH: return s->tx_length;
+    case TX_CORRELATION: return s->tx_correlation;
+    case TX_STATUS: observe_state(s); return s->tx_status;
+    case RX_SOURCE_LOW: return s->rx_source_low;
+    case RX_SOURCE_HIGH: return s->rx_source_high;
+    case RX_RSSI: return s->rx_rssi;
+    case RX_LENGTH: return s->rx_length;
+    case RX_CORRELATION: return s->rx_correlation;
+    case IRQ_STATUS: return s->irq_status;
+    case IRQ_MASK: return s->irq_mask;
+    case STICKY_STATUS: return s->sticky;
+    default: s->sticky |= ST_INVALID; return 0;
+    }
+}
+static void deliver_due(void *opaque)
+{
+    DomesLinkState *s = opaque;
+    int64_t now_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    if (s->fault_id == FAULT_LATENCY_RX_CALLBACK && !s->stage_delay_ns[STAGE_RX_CALLBACK] &&
+        s->event_count && s->events[0].deadline_ns <= now_ns) {
+        s->stage_delay_ns[STAGE_RX_CALLBACK] = 10000;
+        s->stage_enter_ns = now_ns;
+        for (uint32_t index = 0; index < s->event_count; index++) s->events[index].deadline_ns += 10000;
+        timer_mod_ns(s->delivery_timer, s->events[0].deadline_ns);
+        return;
+    }
+    if (s->event_count && s->events[0].deadline_ns <= now_ns)
+        record_stage(STAGE_RX_CALLBACK,
+                     s->stage_delay_ns[STAGE_RX_CALLBACK] ? s->stage_enter_ns : now_ns, now_ns);
+    while (s->event_count && s->events[0].deadline_ns <= now_ns) {
+        if (s->irq_status & IRQ_RX) {
+            break;
+        }
+        DomesLinkEvent event = s->events[0];
+        memmove(&s->events[0], &s->events[1],
+                (s->event_count - 1) * sizeof(s->events[0]));
+        s->event_count--;
+        if (s->fault_id >= FAULT_LATENCY_TX_QUEUE && s->fault_id <= FAULT_LATENCY_RX_CALLBACK) {
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "DOMES_PIPELINE_DELAY schema=1 tx_queue=%" PRIu64 " channel=%" PRIu64
+                          " airtime=%" PRIu64 " completion=%" PRIu64 " peer=%" PRIu64
+                          " rx_callback=%" PRIu64 "\n", s->stage_delay_ns[STAGE_TX_QUEUE],
+                          s->stage_delay_ns[STAGE_CHANNEL], s->stage_delay_ns[STAGE_AIRTIME],
+                          s->stage_delay_ns[STAGE_COMPLETION], s->stage_delay_ns[STAGE_PEER],
+                          s->stage_delay_ns[STAGE_RX_CALLBACK]);
+        }
+        s->rx_source_low = event.source_low;
+        s->rx_source_high = event.source_high;
+        s->rx_rssi = (uint8_t)-42;
+        s->rx_length = event.length;
+        s->rx_correlation = event.correlation;
+        memcpy(s->rx_payload, event.payload, event.length);
+        s->irq_status |= IRQ_RX;
+        if (qemu_loglevel_mask(LOG_GUEST_ERROR)) {
+            g_autofree char *payload = g_malloc0((event.length * 2) + 1);
+            uint32_t index;
+            for (index = 0; index < event.length; index++) {
+                sprintf(payload + (index * 2), "%02x", event.payload[index]);
+            }
+            qemu_log_mask(LOG_GUEST_ERROR,
+                          "DOMES_PEER_DELIVERY schema=1 deadline_ns=%" PRIi64
+                          " class=%u source=%u destination=%u sequence=%" PRIu32
+                          " correlation=%u payload=%s\n",
+                          event.deadline_ns, event.event_class_priority, event.source_id,
+                          event.destination_id, event.sequence, event.correlation, payload);
+        }
+    }
+    if (s->event_count && !(s->irq_status & IRQ_RX)) {
+        timer_mod_ns(s->delivery_timer, s->events[0].deadline_ns);
+    }
+    update_irq(s);
+}
+static void complete(void *opaque)
+{
+    DomesLinkState *s = opaque;
+    DomesLinkEvent event = { 0 };
+    int64_t now_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+    record_stage(s->tx_stage, s->stage_enter_ns, now_ns);
+    if (s->tx_stage < STAGE_COMPLETION) {
+        s->tx_stage = s->tx_stage == STAGE_TX_QUEUE ? STAGE_CHANNEL : STAGE_COMPLETION;
+        s->stage_enter_ns = now_ns;
+        timer_mod_ns(s->completion_timer, now_ns + s->stage_delay_ns[s->tx_stage]);
+        return;
+    }
+    if (s->tx_status != TX_PENDING || !s->tx_correlation || !s->tx_length ||
+        s->tx_length > DOMES_LINK_MAX_PAYLOAD) {
+        s->sticky |= ST_MODEL_FAILURE;
+        s->tx_status = TX_FAILURE;
+        s->irq_status |= IRQ_TX;
+        update_irq(s);
+        return;
+    }
+    if (s->fault_id == FAULT_COMPLETION_FAILURE) {
+        s->tx_status = TX_FAILURE;
+        s->irq_status |= IRQ_TX;
+        record_fault(s, "completion_delay", "failure");
+        update_irq(s);
+        return;
+    }
+    s->tx_status = TX_SUCCESS;
+    s->irq_status |= IRQ_TX;
+    if (s->scenario_model == SCENARIO_LOOPBACK) {
+        if (s->irq_status & IRQ_RX) {
+            s->sticky |= ST_OVERFLOW | ST_OVERWRITE;
+        } else {
+            s->rx_source_low = 0x00000002;
+            s->rx_source_high = 0x00000200;
+            s->rx_rssi = (uint8_t)-42;
+            s->rx_length = s->tx_length;
+            s->rx_correlation = s->tx_correlation;
+            memcpy(s->rx_payload, s->tx_payload, s->tx_length);
+            s->irq_status |= IRQ_RX;
+        }
+    } else if (s->scenario_model != SCENARIO_FUNCTIONAL_PEER_V1 ||
+               !actor_transition(s, &event)) {
+        s->sticky |= ST_MODEL_FAILURE;
+        s->tx_status = TX_FAILURE;
+    } else if (s->fault_id == FAULT_BACKPRESSURE_RECOVERY && s->scenario_consumed) { update_irq(s); return;
+    } else if (event.length) { s->scenario_consumed = true;
+        if (s->fault_id >= FAULT_PEER_JOIN && s->fault_id <= FAULT_STALE_TRAFFIC)
+            record_peer(s, s->fault_id == FAULT_PEER_JOIN ? "join" : s->fault_id == FAULT_PEER_DISAPPEARANCE ? "absent" : s->fault_id == FAULT_PEER_RESTART ? "restart" : "stale", s->fault_id == FAULT_STALE_TRAFFIC ? 1 : s->peer_epoch, s->fault_id != FAULT_PEER_DISAPPEARANCE && s->fault_id != FAULT_STALE_TRAFFIC);
+        uint32_t copies = 1;
+        uint64_t spacing_ns = 1000;
+        uint32_t initial_count = s->event_count;
+        if (s->fault_id == FAULT_LOSS || s->fault_id == FAULT_PEER_DISAPPEARANCE ||
+            s->fault_id == FAULT_CHANNEL_OUTCOME ||
+            s->fault_id == FAULT_INTERFERENCE_OUTCOME) {
+            record_fault(s, fault_stage(s->fault_id), "unavailable");
+            update_irq(s);
+            return;
+        }
+        if (s->fault_id == FAULT_CORRUPTION) {
+            event.payload[0] ^= 0x80;
+        } else if (s->fault_id == FAULT_TRUNCATION) {
+            event.length = 7;
+        } else if (s->fault_id == FAULT_IDENTITY_MISMATCH) {
+            event.source_low = 0x00000003;
+        } else if (s->fault_id == FAULT_DUPLICATION || s->fault_id == FAULT_REORDERING ||
+                   s->fault_id == FAULT_PEER_RESTART || s->fault_id == FAULT_STALE_TRAFFIC) {
+            copies = 2;
+        } else if (s->fault_id == FAULT_CALLBACK_BURST) {
+            copies = 3;
+            spacing_ns = 1;
+        } else if (s->fault_id == FAULT_SATURATION ||
+                   s->fault_id == FAULT_BACKPRESSURE_RECOVERY) {
+            copies = s->fault_id == FAULT_SATURATION ? 4 : 5;
+            spacing_ns = 1;
+        }
+        if (s->fault_id == FAULT_JITTER) {
+            event.deadline_ns += s->dut_role == DUT_ROLE_MASTER ? 7000 : -7000;
+        }
+        if (s->fault_id == FAULT_LATENCY_AIRTIME) {
+            s->stage_delay_ns[STAGE_AIRTIME] = 10000;
+            event.deadline_ns += s->stage_delay_ns[STAGE_AIRTIME];
+        }
+        record_stage(STAGE_PEER, now_ns,
+                     now_ns + s->peer_delay_ns + s->stage_delay_ns[STAGE_PEER]);
+        record_stage(STAGE_AIRTIME,
+                     now_ns + s->peer_delay_ns + s->stage_delay_ns[STAGE_PEER],
+                     event.deadline_ns);
+        if (s->fault_id == FAULT_SATURATION || s->fault_id == FAULT_BACKPRESSURE_RECOVERY) event.deadline_ns += 100000;
+        for (uint32_t copy = 0; copy < copies; copy++) {
+            DomesLinkEvent candidate = event;
+            if ((s->fault_id >= FAULT_CALLBACK_BURST && s->fault_id < FAULT_SATURATION && copy > 0) || (s->fault_id >= FAULT_SATURATION && s->fault_id <= FAULT_BACKPRESSURE_RECOVERY && copy != 3))
+                candidate.payload[0] = MSG_TOUCH_EVENT, candidate.length = wire_size(MSG_TOUCH_EVENT);
+            if (s->fault_id == FAULT_REORDERING) {
+                candidate.deadline_ns += (copies - copy) * spacing_ns;
+            } else {
+                candidate.deadline_ns += copy * spacing_ns;
+            }
+            if (s->fault_id == FAULT_STALE_TRAFFIC && copy == 0) {
+                candidate.source_low = 0x00000003;
+            } else if (s->fault_id == FAULT_STALE_TRAFFIC) {
+                record_peer(s, "fresh", 2, true);
+            }
+            if (s->fault_id == FAULT_BACKPRESSURE_RECOVERY && copy == 4) {
+                s->readmission_event = candidate;
+                s->readmission_pending = true;
+            } else if (!enqueue_event(s, candidate)) break;
+        }
+        if (s->fault_id == FAULT_SATURATION || s->fault_id == FAULT_BACKPRESSURE_RECOVERY)
+            record_fault(s, "channel_access", "production_capacity_4");
+        if (s->fault_id != FAULT_LATENCY_TX_QUEUE && s->fault_id != FAULT_LATENCY_CHANNEL && s->fault_id != FAULT_LATENCY_COMPLETION) record_fault(s, fault_stage(s->fault_id),
+                     s->fault_id == FAULT_PEER_RESTART ? "restart_epoch_2" :
+                     s->fault_id == FAULT_STALE_TRAFFIC ? "stale_epoch_1_then_2" :
+                     copies > 1 ? "scheduled_multiple" : "scheduled");
+        if (s->event_count != initial_count + copies - (s->readmission_pending ? 1 : 0)) {
+            s->sticky |= ST_MODEL_FAILURE;
+            s->tx_status = TX_FAILURE;
+        } else {
+            timer_mod_ns(s->delivery_timer, s->events[0].deadline_ns);
+            deliver_due(s);
+        }
+    }
+    if (s->fault_id == FAULT_COMPLETION_ORDER) s->tx_correlation = 3;
+    update_irq(s);
+}
+static void reorder_complete(void *opaque) { DomesLinkState *s = opaque; s->irq_status |= IRQ_TX; record_fault(s, "completion_delay", s->tx_correlation == 1 ? "completion_token_1" : "completion_token_2"); update_irq(s); }
+static void link_write(void *opaque, hwaddr addr, uint64_t value, unsigned size)
+{
+    DomesLinkState *s = opaque;
+    if (!word_access(addr, size)) {
+        s->sticky |= ST_INVALID;
+        return;
+    }
+    if (addr >= TX_PAYLOAD && addr < TX_PAYLOAD + sizeof(s->tx_payload)) {
+        if (tx_locked(s)) {
+            reject_tx_mutation(s);
+            return;
+        }
+        stl_le_p(&s->tx_payload[addr - TX_PAYLOAD], value);
+        return;
+    }
+    if (addr >= RX_PAYLOAD && addr < RX_PAYLOAD + sizeof(s->rx_payload)) {
+        s->sticky |= ST_INVALID;
+        return;
+    }
+    switch (addr) {
+    case ABI_VERSION:
+        if (value != VERSION) s->sticky |= ST_UNKNOWN_VERSION;
+        break;
+    case TX_DEST_LOW:
+        if (tx_locked(s)) reject_tx_mutation(s);
+        else s->tx_destination_low = value;
+        break;
+    case TX_DEST_HIGH:
+        if (tx_locked(s)) reject_tx_mutation(s);
+        else if (value & 0xffff0000) s->sticky |= ST_INVALID;
+        else s->tx_destination_high = value;
+        break;
+    case TX_LENGTH:
+        if (tx_locked(s)) reject_tx_mutation(s);
+        else if (!value || value > DOMES_LINK_MAX_PAYLOAD) s->sticky |= ST_TRUNCATED;
+        else s->tx_length = value;
+        break;
+    case TX_CORRELATION:
+        if (tx_locked(s)) reject_tx_mutation(s);
+        else if (!value) s->sticky |= ST_SEQUENCE;
+        else s->tx_correlation = value;
+        break;
+    case TX_SUBMIT:
+        if (value != 1 || s->sticky || tx_locked(s) || !s->tx_length ||
+            !s->tx_correlation) {
+            if (tx_locked(s)) reject_tx_mutation(s);
+            else {
+                s->sticky |= ST_SEQUENCE;
+                s->tx_status = TX_FAILURE;
+            }
+        } else if (s->fault_id == FAULT_SUBMIT_FAILURE) {
+            s->tx_status = TX_FAILURE;
+            record_fault(s, "radio_submit", "failure");
+        } else if (s->fault_id == FAULT_MISSING_COMPLETION) {
+            s->tx_status = TX_PENDING;
+            record_fault(s, "completion_delay", "missing");
+        } else {
+            if (s->fault_id == FAULT_LATENCY_TX_QUEUE) s->stage_delay_ns[STAGE_TX_QUEUE] = 10000;
+            if (s->fault_id == FAULT_LATENCY_CHANNEL) s->stage_delay_ns[STAGE_CHANNEL] = 10000;
+            if (s->fault_id == FAULT_LATENCY_COMPLETION) s->stage_delay_ns[STAGE_COMPLETION] = 10000;
+            if (s->fault_id == FAULT_LATENCY_TX_QUEUE || s->fault_id == FAULT_LATENCY_CHANNEL || s->fault_id == FAULT_LATENCY_COMPLETION) record_fault(s, fault_stage(s->fault_id), "delay_enter");
+            s->tx_status = TX_PENDING;
+            s->stage_delay_ns[STAGE_CHANNEL] += 1000;
+            s->tx_stage = STAGE_TX_QUEUE;
+            s->stage_enter_ns = qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL);
+            timer_mod_ns(s->completion_timer,
+                         s->stage_enter_ns + s->stage_delay_ns[STAGE_TX_QUEUE]);
+        }
+        break;
+    case RX_CONSUME:
+        if (value != 1 || !(s->irq_status & IRQ_RX)) s->sticky |= ST_SEQUENCE;
+        else {
+            s->irq_status &= ~IRQ_RX;
+            s->rx_length = s->rx_correlation = 0;
+            update_irq(s);
+        }
+        break;
+    case RX_DEQUEUE:
+        if (value != 1) s->sticky |= ST_SEQUENCE;
+        else if (s->readmission_pending) {
+            record_fault(s, "channel_access", "production_dequeued");
+            if (!enqueue_event(s, s->readmission_event)) s->sticky |= ST_MODEL_FAILURE;
+            else { record_fault(s, "channel_access", "readmitted"); timer_mod_ns(s->delivery_timer, MAX(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1, s->events[0].deadline_ns)); }
+            s->readmission_pending = false;
+        }
+        break;
+    case IRQ_MASK:
+        if (value & ~(IRQ_TX | IRQ_RX)) s->sticky |= ST_INVALID;
+        else { s->irq_mask = value; update_irq(s); }
+        break;
+    case IRQ_ACK:
+        if (value & ~(IRQ_TX | IRQ_RX)) s->sticky |= ST_INVALID;
+        s->irq_status &= ~(value & (IRQ_TX | IRQ_RX));
+        update_irq(s);
+        if ((value & IRQ_TX) && s->fault_id == FAULT_COMPLETION_ORDER && s->tx_status == TX_SUCCESS && s->tx_correlation != 2) {
+            s->tx_correlation = s->tx_correlation == 3 ? 1 : 2;
+            timer_mod_ns(s->reorder_timer, qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1);
+        } else if ((value & IRQ_TX) != 0 && (s->irq_status & IRQ_TX) == 0) {
+            s->tx_destination_low = s->tx_destination_high = s->tx_length = 0;
+            s->tx_correlation = 0;
+            s->tx_status = TX_IDLE;
+            memset(s->tx_payload, 0, sizeof(s->tx_payload));
+        }
+        if ((value & IRQ_RX) && s->event_count)
+            timer_mod_ns(s->delivery_timer, MAX(qemu_clock_get_ns(QEMU_CLOCK_VIRTUAL) + 1,
+                                                 s->events[0].deadline_ns));
+        else update_irq(s);
+        break;
+    default: s->sticky |= ST_INVALID; break;
+    }
+}
+static const MemoryRegionOps link_ops = {
+    .read = link_read, .write = link_write, .endianness = DEVICE_LITTLE_ENDIAN,
+    .valid = { .min_access_size = 1, .max_access_size = 4, .unaligned = true },
+};
+static void link_reset(Object *obj, ResetType type)
+{
+    DomesLinkState *s = DOMES_LINK(obj);
+    s->tx_destination_low = s->tx_destination_high = s->tx_length = 0;
+    s->tx_correlation = 0; s->tx_status = TX_IDLE;
+    s->rx_source_low = s->rx_source_high = s->rx_rssi = s->rx_length = 0;
+    s->rx_correlation = s->irq_status = s->irq_mask = s->sticky = 0;
+    s->readmission_pending = s->scenario_consumed = false; s->event_count = s->next_sequence = s->fault_sequence = 0;
+    s->peer_present = s->fault_id != FAULT_PEER_JOIN; s->peer_epoch = 1;
+    s->tx_stage = 0; s->stage_enter_ns = 0; memset(s->stage_delay_ns, 0, sizeof(s->stage_delay_ns));
+    memset(s->tx_payload, 0, sizeof(s->tx_payload));
+    memset(s->rx_payload, 0, sizeof(s->rx_payload));
+    memset(s->events, 0, sizeof(s->events));
+    timer_del(s->completion_timer); timer_del(s->reorder_timer);
+    timer_del(s->delivery_timer);
+    update_irq(s);
+}
+static void link_realize(DeviceState *dev, Error **errp)
+{
+    DomesLinkState *s = DOMES_LINK(dev);
+    s->completion_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, complete, s); s->reorder_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, reorder_complete, s);
+    s->delivery_timer = timer_new_ns(QEMU_CLOCK_VIRTUAL, deliver_due, s);
+}
+static void link_finalize(Object *obj)
+{
+    DomesLinkState *s = DOMES_LINK(obj);
+    timer_free(s->completion_timer); timer_free(s->reorder_timer);
+    timer_free(s->delivery_timer);
+}
+static void link_init(Object *obj)
+{
+    DomesLinkState *s = DOMES_LINK(obj);
+    memory_region_init_io(&s->mmio, obj, &link_ops, s, TYPE_DOMES_LINK, DOMES_LINK_MMIO_SIZE);
+    sysbus_init_mmio(SYS_BUS_DEVICE(obj), &s->mmio);
+    sysbus_init_irq(SYS_BUS_DEVICE(obj), &s->irq);
+}
+static void link_class_init(ObjectClass *klass, void *data)
+{
+    DeviceClass *dc = DEVICE_CLASS(klass);
+    ResettableClass *rc = RESETTABLE_CLASS(klass);
+    dc->realize = link_realize;
+    static const Property properties[] = {
+        DEFINE_PROP_UINT32("scenario-model", DomesLinkState, scenario_model, SCENARIO_LOOPBACK),
+        DEFINE_PROP_UINT32("scenario-seed", DomesLinkState, scenario_seed, 0),
+        DEFINE_PROP_UINT32("dut-role", DomesLinkState, dut_role, DUT_ROLE_MASTER),
+        DEFINE_PROP_UINT64("peer-delay-ns", DomesLinkState, peer_delay_ns, 0),
+        DEFINE_PROP_UINT32("fault-id", DomesLinkState, fault_id, FAULT_PASS),
+        DEFINE_PROP_END_OF_LIST(),
+    };
+    device_class_set_props(dc, properties);
+    rc->phases.hold = link_reset;
+}
+static const TypeInfo link_info = {
+    .name = TYPE_DOMES_LINK, .parent = TYPE_SYS_BUS_DEVICE,
+    .instance_size = sizeof(DomesLinkState), .instance_init = link_init,
+    .instance_finalize = link_finalize, .class_init = link_class_init,
+};
+static void link_register_types(void) { type_register_static(&link_info); }
+type_init(link_register_types)
