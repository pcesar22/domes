diff --git a/include/hw/misc/domes_link.h b/include/hw/misc/domes_link.h
new file mode 100644
index 0000000000..89c86d6f15
--- /dev/null
+++ b/include/hw/misc/domes_link.h
@@ -0,0 +1,37 @@
+#pragma once
+#include "hw/sysbus.h"
+#include "qemu/main-loop.h"
+#include "qemu/timer.h"
+#define TYPE_DOMES_LINK "domes-link"
+OBJECT_DECLARE_SIMPLE_TYPE(DomesLinkState, DOMES_LINK)
+#define DOMES_LINK_MMIO_SIZE 0x1000
+#define DOMES_LINK_MAX_PAYLOAD 250
+#define DOMES_LINK_EVENT_CAPACITY 8
+typedef struct DomesLinkEvent {
+    int64_t deadline_ns;
+    uint32_t event_class_priority;
+    uint32_t source_id, destination_id, sequence;
+    uint32_t correlation, length;
+    uint32_t source_low, source_high;
+    uint8_t payload[DOMES_LINK_MAX_PAYLOAD];
+} DomesLinkEvent;
+struct DomesLinkState {
+    SysBusDevice parent_obj;
+    MemoryRegion mmio;
+    qemu_irq irq;
+    QEMUTimer *completion_timer, *reorder_timer;
+    QEMUTimer *delivery_timer;
+    uint32_t tx_destination_low, tx_destination_high, tx_length, tx_correlation, tx_status;
+    uint32_t rx_source_low, rx_source_high, rx_rssi, rx_length, rx_correlation;
+    uint32_t irq_status, irq_mask, sticky;
+    uint8_t tx_payload[256], rx_payload[256];
+    DomesLinkEvent events[DOMES_LINK_EVENT_CAPACITY], readmission_event;
+    uint32_t event_count, next_sequence;
+    bool readmission_pending, scenario_consumed;
+    int64_t last_observation_ns;
+    uint32_t scenario_model, scenario_seed, dut_role, fault_id, fault_sequence, peer_epoch;
+    bool peer_present;
+    uint64_t peer_delay_ns;
+    uint64_t stage_delay_ns[6];
+    uint32_t tx_stage; int64_t stage_enter_ns;
+};
