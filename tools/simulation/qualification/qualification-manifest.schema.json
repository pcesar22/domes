{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://domes.invalid/schemas/vc-wp-002a-qualification-manifest-v1.json",
  "title": "VC-WP-002A immutable corpus and threshold freeze",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "creation_phase", "specification_revision", "owner", "task", "entry", "controller_attestation_sha256", "input_allowlist", "input_allowlist_sha256", "public_input_sha256", "candidate", "datasets", "clock_correlation", "tools", "corpus_construction", "mutation_corpus", "held_out_scenarios", "metrics", "thresholds", "prediction_envelope", "exclusions", "invalidation_rules", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "vc-wp-002a-corpus-threshold-freeze"},
    "creation_phase": {"const": "pre-held-out"},
    "specification_revision": {"const": "be347355d3747b849b0521e40c539aae88d33614"},
    "owner": {"const": "independent-ai-verification"},
    "task": {"$ref": "#/$defs/task"},
    "entry": {"$ref": "#/$defs/entry"},
    "controller_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "input_allowlist": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "input_allowlist_sha256": {"$ref": "#/$defs/sha256"},
    "public_input_sha256": {"$ref": "#/$defs/sha256"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "datasets": {"$ref": "#/$defs/datasets"},
    "clock_correlation": {"$ref": "#/$defs/clock"},
    "tools": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/identity"}},
    "corpus_construction": {"$ref": "#/$defs/corpusConstruction"},
    "mutation_corpus": {"type": "array", "minItems": 15, "maxItems": 15, "items": {"$ref": "#/$defs/mutant"}},
    "held_out_scenarios": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/heldOutScenario"}},
    "metrics": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/metric"}},
    "thresholds": {"type": "object", "additionalProperties": false, "required": ["critical_detection_percent", "complete_corpus_detection_percent_min"], "properties": {"critical_detection_percent": {"const": 100}, "complete_corpus_detection_percent_min": {"const": 95}}},
    "prediction_envelope": {"$ref": "#/$defs/predictionEnvelope"},
    "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "invalidation_rules": {"type": "array", "minItems": 10, "maxItems": 10, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["id", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "predictionEnvelope": {"type": "object", "additionalProperties": false, "required": ["id", "dimensions", "sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "dimensions": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["scheduler", "transport", "stale-event", "recovery", "concurrency"]}}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "dataset": {"type": "object", "additionalProperties": false, "required": ["id", "sha256", "scenario", "scenario_sha256", "seed", "seed_sha256", "raw_trace_sha256", "normalized_trace_sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "scenario": {"type": "string", "minLength": 1}, "scenario_sha256": {"$ref": "#/$defs/sha256"}, "seed": {"type": "integer", "minimum": 0}, "seed_sha256": {"$ref": "#/$defs/sha256"}, "raw_trace_sha256": {"$ref": "#/$defs/sha256"}, "normalized_trace_sha256": {"$ref": "#/$defs/sha256"}}},
    "datasets": {"type": "object", "additionalProperties": false, "required": ["calibration", "held_out"], "properties": {"calibration": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataset"}}, "held_out": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/dataset"}}}},
    "fs2g": {"type": "object", "additionalProperties": false, "required": ["issue", "commit", "evidence_sha256", "campaign_sha256"], "properties": {"issue": {"type": "integer", "minimum": 1}, "commit": {"$ref": "#/$defs/gitSha"}, "evidence_sha256": {"$ref": "#/$defs/sha256"}, "campaign_sha256": {"$ref": "#/$defs/sha256"}}},
    "terminalCandidate": {"type": "object", "additionalProperties": false, "required": ["issue", "artifact_class", "commit", "evidence_sha256", "candidate_sha256", "fs_wp_002g"], "properties": {"issue": {"type": "integer", "minimum": 1}, "artifact_class": {"const": "terminal-executed-validation"}, "commit": {"$ref": "#/$defs/gitSha"}, "evidence_sha256": {"$ref": "#/$defs/sha256"}, "candidate_sha256": {"$ref": "#/$defs/sha256"}, "fs_wp_002g": {"$ref": "#/$defs/fs2g"}}},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["model_sha256", "firmware_revision", "firmware_image_sha256", "hardware", "configuration", "prediction_envelope", "exclusions", "fs_wp_002g_campaign_sha256"], "properties": {"model_sha256": {"$ref": "#/$defs/sha256"}, "firmware_revision": {"$ref": "#/$defs/gitSha"}, "firmware_image_sha256": {"$ref": "#/$defs/sha256"}, "hardware": {"$ref": "#/$defs/identity"}, "configuration": {"$ref": "#/$defs/identity"}, "prediction_envelope": {"$ref": "#/$defs/predictionEnvelope"}, "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "fs_wp_002g_campaign_sha256": {"$ref": "#/$defs/sha256"}}},
    "clock": {"type": "object", "additionalProperties": false, "required": ["method", "method_sha256", "uncertainty_ns"], "properties": {"method": {"type": "string", "minLength": 1}, "method_sha256": {"$ref": "#/$defs/sha256"}, "uncertainty_ns": {"type": "integer", "minimum": 0}}},
    "task": {"type": "object", "additionalProperties": false, "required": ["issue", "parent_issue", "dependency_issue", "work_class", "allowed_surface", "stop_condition"], "properties": {"issue": {"const": 165}, "parent_issue": {"const": 160}, "dependency_issue": {"const": 159}, "work_class": {"const": "executed-validation"}, "allowed_surface": {"const": "tools/simulation/**"}, "stop_condition": {"const": "software-review-required-human-review"}}},
    "entry": {"type": "object", "additionalProperties": false, "required": ["result", "terminal_candidate"], "properties": {"result": {"const": "passed"}, "terminal_candidate": {"$ref": "#/$defs/terminalCandidate"}}},
    "mutationDefinition": {"type": "object", "additionalProperties": false, "required": ["operator", "injection_point", "activation", "expected_observation"], "properties": {"operator": {"type": "string", "minLength": 1}, "injection_point": {"type": "string", "minLength": 1}, "activation": {"const": "single-seeded-fault"}, "expected_observation": {"const": "candidate-prediction-versus-mutated-trace"}}},
    "corpusConstruction": {"type": "object", "additionalProperties": false, "required": ["method", "prediction_envelope_sha256", "required_classes", "mutant_definition_sha256s", "completeness_sha256"], "properties": {"method": {"const": "independent-static-envelope-enumeration-v1"}, "prediction_envelope_sha256": {"$ref": "#/$defs/sha256"}, "required_classes": {"type": "array", "minItems": 5, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["scheduler", "transport", "stale-event", "recovery", "concurrency"]}}, "mutant_definition_sha256s": {"type": "array", "minItems": 15, "maxItems": 15, "uniqueItems": true, "items": {"$ref": "#/$defs/sha256"}}, "completeness_sha256": {"$ref": "#/$defs/sha256"}}},
    "mutant": {"type": "object", "additionalProperties": false, "required": ["id", "class", "critical_seeded_fault", "suppressed", "definition", "definition_sha256", "execution_contract_sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "class": {"enum": ["scheduler", "transport", "stale-event", "recovery", "concurrency"]}, "critical_seeded_fault": {"type": "boolean"}, "suppressed": {"const": false}, "definition": {"$ref": "#/$defs/mutationDefinition"}, "definition_sha256": {"$ref": "#/$defs/sha256"}, "execution_contract_sha256": {"$ref": "#/$defs/sha256"}}},
    "heldOutScenario": {"type": "object", "additionalProperties": false, "required": ["id", "scenario_sha256", "seed", "seed_sha256", "dataset_id", "dataset_sha256", "raw_trace_sha256", "normalized_trace_sha256"], "properties": {"id": {"type": "string", "minLength": 1}, "scenario_sha256": {"$ref": "#/$defs/sha256"}, "seed": {"type": "integer", "minimum": 0}, "seed_sha256": {"$ref": "#/$defs/sha256"}, "dataset_id": {"type": "string", "minLength": 1}, "dataset_sha256": {"$ref": "#/$defs/sha256"}, "raw_trace_sha256": {"$ref": "#/$defs/sha256"}, "normalized_trace_sha256": {"$ref": "#/$defs/sha256"}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["id", "bound"], "properties": {"id": {"enum": ["outcome", "ordering", "timeout", "queue-depth", "latency"]}, "bound": {"type": "string", "minLength": 1}}}
  }
}
