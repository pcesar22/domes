# DOMES serial-device access rules
#
# Install with:
#   sudo cp tools/udev/99-domes-pods.rules /etc/udev/rules.d/
#   sudo udevadm control --reload-rules
#   sudo udevadm trigger
#
# Use /dev/serial/by-id/ links for persistent device identity. Kernel names such
# as ttyUSB0 and ttyACM0 depend on enumeration order and are not stable aliases.

# Silicon Labs CP2102N bridge: flash, framed UART config, and serial OTA.
SUBSYSTEM=="tty", ATTRS{idVendor}=="10c4", ATTRS{idProduct}=="ea60", \
    MODE="0660", TAG+="uaccess"

# Native ESP32-S3 USB Serial/JTAG: console and JTAG.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1001", \
    MODE="0660", TAG+="uaccess"

# ESP32-S3 USB-OTG CDC, when enabled by a board profile.
SUBSYSTEM=="tty", ATTRS{idVendor}=="303a", ATTRS{idProduct}=="1002", \
    MODE="0660", TAG+="uaccess"
