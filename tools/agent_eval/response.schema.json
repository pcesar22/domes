{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "summary",
    "files",
    "invariants",
    "verification",
    "hardware_requirement",
    "claims",
    "criterion_evidence"
  ],
  "properties": {
    "summary": { "type": "string" },
    "files": {
      "type": "array",
      "items": { "type": "string" }
    },
    "invariants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "verification": {
      "type": "array",
      "items": { "type": "string" }
    },
    "hardware_requirement": {
      "type": "string",
      "description": "Whether physical hardware is required for full validation. This is not an execution status; the evaluation harness never accesses hardware.",
      "enum": ["not_required", "required"]
    },
    "claims": {
      "type": "array",
      "items": { "type": "string" }
    },
    "criterion_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion_id", "evidence", "files"],
        "properties": {
          "criterion_id": { "type": "string" },
          "evidence": {
            "type": "array",
            "items": { "type": "string" }
          },
          "files": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
