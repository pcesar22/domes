{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOMES autonomous selector result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "state",
    "spec_revision",
    "mode",
    "base_strategy",
    "existing_issue",
    "existing_pull_request",
    "work_package",
    "work_class",
    "title",
    "parent_objective",
    "goal",
    "non_goals",
    "required_behavior",
    "acceptance_checks",
    "allowed_surfaces",
    "dependencies",
    "required_proof",
    "priority",
    "autonomy_policy",
    "rationale",
    "blockers"
  ],
  "properties": {
    "state": {"type": "string", "enum": ["selected", "idle", "blocked"]},
    "spec_revision": {"type": "string", "pattern": "^$|^[0-9a-f]{40}$"},
    "mode": {"type": "string", "enum": ["execute", "plan", "none"]},
    "base_strategy": {"type": "string", "enum": ["main", "dependency", "none"]},
    "existing_issue": {"type": "integer", "minimum": 0},
    "existing_pull_request": {"type": "integer", "minimum": 0},
    "work_package": {"type": "string"},
    "work_class": {"type": "string", "enum": ["software", "executed-validation", "none"]},
    "title": {"type": "string"},
    "parent_objective": {"type": "string"},
    "goal": {"type": "string"},
    "non_goals": {"type": "array", "items": {"type": "string"}},
    "required_behavior": {"type": "string"},
    "acceptance_checks": {"type": "array", "items": {"type": "string"}},
    "allowed_surfaces": {"type": "array", "items": {"type": "string"}},
    "dependencies": {"type": "array", "items": {"type": "integer", "minimum": 1}},
    "required_proof": {"type": "array", "items": {"type": "string"}},
    "priority": {"type": "string", "enum": ["p0", "p1", "p2", "p3", "none"]},
    "autonomy_policy": {"type": "string", "enum": ["software-review-required", "review-only", "none"]},
    "rationale": {"type": "string"},
    "blockers": {"type": "array", "items": {"type": "string"}}
  }
}
