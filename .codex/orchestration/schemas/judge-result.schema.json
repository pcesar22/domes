{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOMES independent judge result",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue", "spec_revision", "commit", "pull_request", "verdict", "criteria", "required_rework", "claim_boundary"],
  "properties": {
    "issue": {"type": "integer", "minimum": 1},
    "spec_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pull_request": {"type": ["integer", "null"], "minimum": 1},
    "verdict": {"type": "string", "enum": ["approve", "reject", "blocked"]},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["criterion", "status", "evidence"],
        "properties": {
          "criterion": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["met", "not_met", "not_verifiable"]},
          "evidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "required_rework": {"type": "array", "items": {"type": "string"}},
    "claim_boundary": {"type": "string", "minLength": 1}
  }
}
