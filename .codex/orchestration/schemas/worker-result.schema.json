{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOMES worker result",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue", "state", "spec_revision", "commit", "pull_request", "verification", "blockers", "proposed_followups"],
  "properties": {
    "issue": {"type": "integer", "minimum": 1},
    "state": {"type": "string", "const": "agent_review"},
    "spec_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pull_request": {"type": ["integer", "null"], "minimum": 1},
    "verification": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["level", "command_or_observation", "status", "artifact"],
        "properties": {
          "level": {"type": "string", "enum": ["automated", "accepted_command", "physical"]},
          "command_or_observation": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["passed", "failed", "pending", "unavailable", "not_applicable"]},
          "artifact": {"type": ["string", "null"]}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}},
    "proposed_followups": {"type": "array", "items": {"type": "string"}}
  }
}
