{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DOMES planner result",
  "type": "object",
  "additionalProperties": false,
  "required": ["issue", "spec_revision", "summary", "tasks", "blockers"],
  "properties": {
    "issue": {"type": "integer", "minimum": 1},
    "spec_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "summary": {"type": "string", "minLength": 1},
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "mode", "base_strategy", "goal", "non_goals", "required_behavior", "acceptance_checks", "allowed_surfaces", "dependencies", "required_proof", "autonomy_policy", "hardware_operations"],
        "properties": {
          "key": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "enum": ["execute", "plan"]},
          "base_strategy": {"type": "string", "enum": ["main", "dependency"]},
          "goal": {"type": "string", "minLength": 1},
          "non_goals": {"type": "array", "items": {"type": "string"}},
          "required_behavior": {"type": "string", "minLength": 1},
          "acceptance_checks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "allowed_surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "required_proof": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "autonomy_policy": {"type": "string", "enum": ["software-review-required", "review-only"]},
          "hardware_operations": {"type": "array", "items": {"type": "string", "enum": ["info", "health", "self-test", "memory", "feature-list", "trace-start", "trace-stop", "trace-clear", "trace-status", "trace-dump", "flash", "flash-trace-acceptance", "ota", "reset", "run", "artifact-hash"]}}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}}
  }
}
