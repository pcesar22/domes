{
  "schema_version": 1,
  "policy_name": "domes-human-review-autopilot-v2",
  "allowed_work_classes": [
    "software",
    "executed-validation"
  ],
  "required_ci_checks": [
    "Build ESP32-S3 Firmware",
    "Execute ESP32-S3 QEMU Runtime",
    "Run Unit Tests",
    "Build CLI Tool",
    "Test Host Tooling",
    "Flutter / Analyze And Test Flutter App",
    "Flutter / Build iOS App",
    "CI Gate"
  ],
  "protected_autonomous_paths": [
    ".github/**",
    ".codex/**",
    "AGENTS.md",
    "**/AGENTS.md",
    "WORKFLOW.md",
    "PLANS.md",
    "tools/agent_control/**",
    "hardware/**",
    "docs/PRODUCT_REALIZATION_FRAMEWORK.md",
    "docs/TESTING.md",
    "docs/PIN_REFERENCE.md",
    "firmware/domes/main/config.hpp",
    "research/PRODUCT_DEFINITION.md",
    "research/SYSTEM_ARCHITECTURE.md",
    "research/architecture/**",
    "SECURITY.md",
    "**/Cargo.toml",
    "Cargo.toml",
    "**/Cargo.lock",
    "Cargo.lock",
    "**/pubspec.yaml",
    "pubspec.yaml",
    "**/pubspec.lock",
    "pubspec.lock",
    "**/package.json",
    "package.json",
    "**/package-lock.json",
    "package-lock.json",
    "**/requirements*.txt",
    "requirements*.txt",
    "scripts/release*",
    ".release/**"
  ],
  "max_ci_repair_cycles": 3,
  "review_authority": "human"
}
